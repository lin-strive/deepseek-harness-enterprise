<Window x:Class="CompanyHarness.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="超智能 Harness"
        Width="1180"
        Height="760"
        MinWidth="960"
        MinHeight="640"
        Icon="Assets/LogoMark.png"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBarRoot"
                Grid.Row="0"
                Background="{DynamicResource ShellTitleBarBrush}"
                BorderBrush="{DynamicResource ShellTitleDividerBrush}"
                BorderThickness="0,0,0,1"
                MouseRightButtonUp="TitleBarRoot_MouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border x:Name="TitleLogoTile"
                            Width="30"
                            Height="30"
                            CornerRadius="7"
                            Background="{DynamicResource ShellLogoTileBrush}">
                        <Image Width="24"
                               Height="24"
                               Source="Assets/LogoMark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               AutomationProperties.Name="超智能战斗轮椅有限公司" />
                    </Border>
                    <TextBlock Margin="10,0,0,0"
                               Text="超智能 Harness"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ShellTitleTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="TitleStatusPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Visibility="Collapsed"
                            AutomationProperties.LiveSetting="Polite">
                    <Ellipse x:Name="TitleStatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleStatusText"
                               Text="运行中"
                               FontSize="13"
                               Foreground="{DynamicResource ShellTitleSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="EmployeeMenuButton"
                        Grid.Column="3"
                        Margin="0,0,4,0"
                        Style="{StaticResource TitleBarEmployeeButtonStyle}"
                        Visibility="Collapsed"
                        Click="EmployeeMenuButton_Click"
                        AutomationProperties.Name="员工菜单"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="HeaderEmployeeText"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource ShellTitleTextBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0"
                                   Text="&#xE70D;"
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="10"
                                   Foreground="{DynamicResource ShellTitleSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button x:Name="MinimizeWindowButton"
                        Grid.Column="4"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MinimizeWindowButton_Click"
                        AutomationProperties.Name="最小化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="12" Height="12">
                        <Path Data="M 2.5,6.5 H 9.5"
                              Stroke="{Binding Foreground, ElementName=MinimizeWindowButton}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True" />
                    </Grid>
                </Button>
                <Button x:Name="MaximizeWindowButton"
                        Grid.Column="5"
                        Style="{StaticResource TitleBarCaptionButtonStyle}"
                        Click="MaximizeWindowButton_Click"
                        AutomationProperties.Name="最大化"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="12" Height="12">
                        <Path x:Name="MaximizeWindowIcon"
                              Data="M 2.5,2.5 H 9.5 V 9.5 H 2.5 Z"
                              Stroke="{Binding Foreground, ElementName=MaximizeWindowButton}"
                              StrokeThickness="1"
                              StrokeLineJoin="Miter"
                              SnapsToDevicePixels="True" />
                        <Path x:Name="RestoreWindowIcon"
                              Data="M 4.5,2.5 H 9.5 V 7.5 M 2.5,4.5 H 7.5 V 9.5 H 2.5 Z"
                              Stroke="{Binding Foreground, ElementName=MaximizeWindowButton}"
                              StrokeThickness="1"
                              StrokeLineJoin="Miter"
                              SnapsToDevicePixels="True"
                              Visibility="Collapsed" />
                    </Grid>
                </Button>
                <Button x:Name="CloseWindowButton"
                        Grid.Column="6"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseWindowButton_Click"
                        AutomationProperties.Name="关闭"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid Width="12" Height="12">
                        <Path Data="M 3,3 L 9,9 M 9,3 L 3,9"
                              Stroke="{Binding Foreground, ElementName=CloseWindowButton}"
                              StrokeThickness="1"
                              SnapsToDevicePixels="True" />
                    </Grid>
                </Button>

                <Popup x:Name="EmployeeMenuPopup"
                       Grid.Column="3"
                       PlacementTarget="{Binding ElementName=EmployeeMenuButton}"
                       Placement="Bottom"
                       HorizontalOffset="-188"
                       VerticalOffset="4"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       Closed="EmployeeMenuPopup_Closed">
                    <Border Width="288"
                            Padding="12"
                            CornerRadius="10"
                            Background="{DynamicResource ShellMenuBrush}"
                            BorderBrush="{DynamicResource ShellMenuBorderBrush}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.20" Color="#17202A" />
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Margin="10,8,10,10">
                                <TextBlock x:Name="MenuEmployeeNameText"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource ShellTitleTextBrush}" />
                                <TextBlock x:Name="MenuEmployeeDetailsText"
                                           Margin="0,4,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource ShellTitleSecondaryBrush}" />
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ShellMenuBorderBrush}" Margin="0,0,0,10" />
                            <TextBlock Margin="10,0,10,4"
                                       Text="外观"
                                       FontSize="12"
                                       Foreground="{DynamicResource ShellTitleSecondaryBrush}" />
                            <RadioButton x:Name="FollowHarnessThemeOption"
                                         GroupName="ShellTheme"
                                         Content="跟随工作台"
                                         Tag="FollowHarness"
                                         Style="{StaticResource ShellThemeOptionStyle}"
                                         Checked="ShellThemeOption_Checked"
                                         AutomationProperties.Name="外观：跟随工作台" />
                            <RadioButton x:Name="FollowSystemThemeOption"
                                         GroupName="ShellTheme"
                                         Content="跟随 Windows"
                                         Tag="FollowSystem"
                                         Style="{StaticResource ShellThemeOptionStyle}"
                                         Checked="ShellThemeOption_Checked"
                                         AutomationProperties.Name="外观：跟随 Windows" />
                            <RadioButton x:Name="LightThemeOption"
                                         GroupName="ShellTheme"
                                         Content="浅色"
                                         Tag="Light"
                                         Style="{StaticResource ShellThemeOptionStyle}"
                                         Checked="ShellThemeOption_Checked"
                                         AutomationProperties.Name="外观：浅色" />
                            <RadioButton x:Name="DarkThemeOption"
                                         GroupName="ShellTheme"
                                         Content="深色"
                                         Tag="Dark"
                                         Style="{StaticResource ShellThemeOptionStyle}"
                                         Checked="ShellThemeOption_Checked"
                                         AutomationProperties.Name="外观：深色" />
                            <Border Height="1" Background="{DynamicResource ShellMenuBorderBrush}" Margin="0,10" />
                            <Button Content="重启工作台"
                                    Style="{StaticResource ShellMenuActionButtonStyle}"
                                    Click="RestartHarness_Click"
                                    AutomationProperties.Name="重启工作台" />
                            <Button Content="退出超智能 Harness"
                                    Style="{StaticResource ShellMenuActionButtonStyle}"
                                    Click="ExitApplication_Click"
                                    AutomationProperties.Name="退出超智能 Harness" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>

        <Grid x:Name="OnboardingRoot" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.44*" MinWidth="410" />
                <ColumnDefinition Width="0.56*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrandTintBrush}" BorderBrush="#F2D2BE" BorderThickness="0,0,1,0">
                <Grid Margin="54,40,50,42">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Image Width="292"
                           Height="72"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Stretch="Uniform"
                           Source="Assets/LogoHorizontal.png"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="超智能战斗轮椅有限公司" />

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" MaxWidth="380" HorizontalAlignment="Left">
                        <TextBlock Text="让代码留在本地，&#x0a;让模型调用有边界。"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   LineHeight="42"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,16,0,34"
                                   Text="超智能 Harness 在你的电脑上运行，通过员工独立凭据访问统一模型服务。"
                                   FontSize="15"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   LineHeight="24"
                                   TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                                <RowDefinition Height="54" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="3" Width="2" Height="110" Background="#E9B38F" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <Border Grid.Row="0" Width="24" Height="24" CornerRadius="12" Background="White" BorderBrush="{StaticResource BrandBrush}" BorderThickness="2" Panel.ZIndex="1">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrandBrush}" />
                            </Border>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="本地运行" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="工作区和会话默认保存在本机" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Width="24" Height="24" CornerRadius="12" Background="White" BorderBrush="{StaticResource BrandBrush}" BorderThickness="2" Panel.ZIndex="1">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrandBrush}" />
                            </Border>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="公司网关" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="模型权限、额度和并发统一管理" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>

                            <Border Grid.Row="2" Width="24" Height="24" CornerRadius="12" Background="White" BorderBrush="{StaticResource BrandBrush}" BorderThickness="2" Panel.ZIndex="1">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource BrandBrush}" />
                            </Border>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="内容不留存" FontWeight="SemiBold" FontSize="15" />
                                <TextBlock Text="网关不记录代码、提示词和完整回复" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="员工虚拟 Key 由 Windows 凭据管理器保护"
                               FontSize="12"
                               Foreground="{StaticResource TertiaryTextBrush}" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" Background="White">
                <Grid x:Name="ActivationPanel" Width="384" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="激活超智能 Harness" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,30"
                               Text="输入管理员发放的一次性激活码。验证后会先显示你的员工信息。"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               FontSize="14" LineHeight="22" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2">
                        <TextBlock Text="激活码" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBox x:Name="ActivationCodeTextBox"
                                 Height="46"
                                 Padding="13,10"
                                 FontSize="16"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource LineBrush}"
                                 BorderThickness="1"
                                 AutomationProperties.Name="激活码"
                                 AutomationProperties.HelpText="输入管理员发放的一次性激活码"
                                 TextChanged="ActivationCodeTextBox_TextChanged" />
                        <TextBlock Margin="0,8,0,0" Text="支持直接粘贴，验证不会绑定当前设备。" FontSize="12" Foreground="{StaticResource TertiaryTextBrush}" />
                    </StackPanel>

                    <Border x:Name="ActivationErrorBorder"
                            Grid.Row="3"
                            Visibility="Collapsed"
                            Margin="0,18,0,0"
                            Padding="12,10"
                            CornerRadius="6"
                            Background="{StaticResource DangerTintBrush}"
                            BorderBrush="#FDA29B"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="ActivationErrorText"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock x:Name="SupportIdText" Visibility="Collapsed" Margin="0,4,0,0" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="ValidateButton"
                            Grid.Row="4"
                            Margin="0,24,0,0"
                            Content="验证激活码"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsDefault="True"
                            Click="ValidateButton_Click"
                            AutomationProperties.Name="验证激活码" />
                </Grid>

                <Grid x:Name="IdentityPanel" Width="410" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="确认员工身份" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Margin="0,10,0,26" Text="请核对以下信息。确认后，这枚激活码将立即失效。" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" />

                    <Border Grid.Row="2" Padding="22" CornerRadius="14" Background="#F8FAFC" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="姓名" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmployeeNameText" Grid.Column="1" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="工号" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmployeeNumberText" Grid.Row="1" Grid.Column="1" FontSize="15" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="部门" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="EmployeeDepartmentText" Grid.Row="2" Grid.Column="1" FontSize="15" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="返回修改" Width="112" Style="{StaticResource SecondaryButtonStyle}" Click="BackToActivation_Click" />
                        <Button x:Name="ConfirmButton" Grid.Column="1" Margin="12,0,0,0" Content="确认并激活" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click" />
                    </Grid>
                </Grid>

                <Grid x:Name="StartingPanel" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel>
                        <Image Width="72" Height="72" Source="Assets/LogoMark.png" Stretch="Uniform" />
                        <TextBlock x:Name="StartingTitleText" Text="正在准备工作台" Margin="0,26,0,8" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="StartingStatusText" Text="检查本地 Runtime…" FontSize="14" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="StartingProgressBar" Height="4" Margin="0,28,0,0" IsIndeterminate="True" Foreground="{StaticResource BrandBrush}" Background="#E6EDF3" />
                        <Button x:Name="RetryStartButton" Visibility="Collapsed" Margin="0,24,0,0" Content="重新启动" Style="{StaticResource PrimaryButtonStyle}" Click="RetryStartButton_Click" />
                        <TextBlock x:Name="StartErrorText" Visibility="Collapsed" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" FontSize="13" />
                        <Button x:Name="OpenDiagnosticsButton" Visibility="Collapsed" Margin="0,12,0,0" Content="打开诊断目录" Style="{StaticResource SecondaryButtonStyle}" Click="OpenDiagnosticsButton_Click" AutomationProperties.Name="打开启动诊断目录" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Grid x:Name="HarnessRoot"
              Grid.Row="1"
              Visibility="Collapsed"
              Background="{DynamicResource ShellTitleBarBrush}">
            <Grid x:Name="HarnessWebViewHost" />
            <Border x:Name="WebViewLoadingPanel" Background="{DynamicResource ShellTitleBarBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="260" Height="4" IsIndeterminate="True" Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text="正在打开工作台…"
                               Margin="0,16,0,0"
                               Foreground="{DynamicResource ShellTitleSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
